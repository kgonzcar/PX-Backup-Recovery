# Example PX-Backup secrets file.
#
# Usage:
#   1. Copy this file:    cp vars/pxb_recovery.secrets.yaml.example vars/pxb_recovery.secrets.yaml
#   2. Fill in real values for the backend selected in vars/pxb_recovery.yaml
#      (only the block matching pxb_recovery_configuration_backup_location_type is required).
#   3. Encrypt it:        ansible-vault encrypt vars/pxb_recovery.secrets.yaml
#
# The plaintext copy must NEVER be committed; .gitignore excludes it.

# --- Azure BackupLocation secrets ---
pxb_azure_path: "YOUR_AZURE_PATH"
pxb_azure_storage_account_name: "AZURE_ACCOUNT_NAME"
pxb_azure_storage_account_key: "AZURE_STORAGE_KEY_HERE"

# --- S3 BackupLocation secrets ---
pxb_s3_path: "pxbackup-bucket/prefix"
pxb_s3_endpoint: "https://fb-s3.example.com"
pxb_s3_access_key: "S3_ACCESS_KEY_HERE"
pxb_s3_secret_key: "S3_SECRET_KEY_HERE"

# --- NFS BackupLocation secrets ---
pxb_nfs_server: "10.0.0.50"
pxb_nfs_export_path: "/pxbackup"
pxb_nfs_path: "pxbackup-data"
