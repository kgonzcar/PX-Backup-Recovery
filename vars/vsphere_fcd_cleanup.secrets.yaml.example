# Example vSphere/govc credentials.
#
# Usage:
#   1. Copy this file:    cp vars/vsphere_fcd_cleanup.secrets.yaml.example vars/vsphere_fcd_cleanup.secrets.yaml
#   2. Replace the placeholder values with real vCenter credentials.
#   3. Encrypt it:        ansible-vault encrypt vars/vsphere_fcd_cleanup.secrets.yaml
#
# The plaintext copy must NEVER be committed; .gitignore excludes it.

govc_url: "vcenter.example.com"
govc_username: "user@vsphere.local"
govc_password: "REPLACE_ME"
